# MongoDB Atlas connection string (Atlas → Database → Connect → Drivers)
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=crackerpro
DB_NAME=crackerpro

# Auth — use a long random value, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me
# The two system admins (admin portal). Everyone else gets a login from Users & employees.
# ADMIN_EMAIL / ADMIN_PASSWORD are still accepted as admin1.
ADMIN1_EMAIL=admin@example.com
ADMIN1_PASSWORD=change-me
ADMIN1_NAME=System Administrator
ADMIN2_EMAIL=
ADMIN2_PASSWORD=
ADMIN2_NAME=

# Comma-separated list of allowed frontend origins (your Vercel URL)
CORS_ORIGINS=https://your-app.vercel.app
# Optional: regex for this project's Vercel preview deployments (a pattern trusting every Vercel app is ignored)
CORS_ORIGIN_REGEX=https://business-finance-[a-z0-9-]+-waisldigital-5107\.vercel\.app

# Uploaded documents / attachments: gridfs (MongoDB, default — survives redeploys) or local (UPLOAD_ROOT on disk)
FILE_STORAGE=gridfs
# UPLOAD_ROOT=./uploads

# Optional: Microsoft Graph email notifications
NOTIFY_ENABLED=false
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=
NOTIFY_RECIPIENT_EMAIL=
